{
  "version": 8,
  "name": "SIGERIA Híbrido (satélite + etiquetas)",
  "sources": {
    "esri-satelital": {
      "type": "raster",
      "tiles": [
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "attribution": "Esri, Maxar, Earthstar Geographics"
    },
    "esri-referencia": {
      "type": "raster",
      "tiles": [
        "https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "attribution": "Esri — límites y nombres de referencia"
    }
  },
  "layers": [
    {"id": "esri-satelital-layer", "type": "raster", "source": "esri-satelital", "minzoom": 0, "maxzoom": 20},
    {"id": "esri-referencia-layer", "type": "raster", "source": "esri-referencia", "minzoom": 0, "maxzoom": 20}
  ]
}
